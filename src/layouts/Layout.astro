---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Pranav Pahuja | Strategy & Digital Transformation Consultant | Gurugram, India",
  description = "Strategy & Digital Transformation Consultant with 6+ years at Deloitte Consulting. Leads AI-enabled operations programs for Fortune 500 clients across retail, consumer, and healthcare. Based in Gurugram, India. 99.9% error elimination · 300+ hours/month saved · 80% fewer production failures."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://pranavpahuja.com").href;
const ogImage = "https://pranavpahuja.com/images/pranav-pahuja.jpg";
import ResumeViewer from "../components/ResumeViewer";
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- ── Core SEO ──────────────────────────────────── -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pranav Pahuja" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="keywords" content="Strategy Consultant India, Digital Transformation Consultant Gurugram, AI Consultant Deloitte, Management Consultant India, Operations Excellence Consultant, AI Strategy Consultant, Deloitte Consultant India, Pranav Pahuja, Tech Consulting India, Enterprise AI Consultant" />
    <link rel="canonical" href={canonicalURL} />

    <!-- ── GEO / Local SEO ───────────────────────────── -->
    <meta name="geo.region" content="IN-HR" />
    <meta name="geo.placename" content="Gurugram, Haryana, India" />
    <meta name="geo.position" content="28.4595;77.0266" />
    <meta name="ICBM" content="28.4595, 77.0266" />

    <!-- ── Open Graph ────────────────────────────────── -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Pranav Pahuja — Strategy & Digital Transformation Consultant" />
    <meta property="og:site_name" content="Pranav Pahuja" />
    <meta property="og:locale" content="en_IN" />
    <meta property="profile:first_name" content="Pranav" />
    <meta property="profile:last_name" content="Pahuja" />

    <!-- ── Twitter / X Card ──────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Pranav Pahuja — Strategy & Digital Transformation Consultant" />

    <!-- ── Favicon & PWA ─────────────────────────────── -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/pranav-pahuja.jpg" />
    <meta name="theme-color" content="#10b981" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Pranav Pahuja" />

    <!-- ── Performance hints ─────────────────────────── -->
    <link rel="preconnect" href="https://cal.com" />
    <link rel="dns-prefetch" href="https://cal.com" />
    <link rel="preload" href="/fonts/grotesk/SpaceGrotesk-Regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/grotesk/SpaceGrotesk-Medium.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/images/pranav-pahuja.webp" as="image" fetchpriority="high" />

    <!-- ── Rich Structured Data (SEO + GEO + AEO) ───── -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://pranavpahuja.com/#person",
          "name": "Pranav Pahuja",
          "givenName": "Pranav",
          "familyName": "Pahuja",
          "jobTitle": "Strategy & Digital Transformation Consultant",
          "description": "Strategy and Digital Transformation Consultant with 6+ years at Deloitte Consulting USI, leading AI-enabled operations programs for Fortune 500 clients across retail, consumer, public services, and healthcare sectors. Proven in owning end-to-end workstreams, eliminating errors by 99.9%, saving 300+ hours per month, and reducing production failures by 80%.",
          "url": "https://pranavpahuja.com",
          "image": {
            "@type": "ImageObject",
            "url": "https://pranavpahuja.com/images/pranav-pahuja.jpg",
            "width": 1200,
            "height": 1200
          },
          "email": "prnvp@protonmail.ch",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Gurugram",
            "addressRegion": "Haryana",
            "postalCode": "122001",
            "addressCountry": "IN"
          },
          "alumniOf": {
            "@type": "CollegeOrUniversity",
            "name": "Thapar Institute of Engineering & Technology",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Patiala",
              "addressRegion": "Punjab",
              "addressCountry": "IN"
            }
          },
          "worksFor": {
            "@type": "Organization",
            "name": "Deloitte Consulting USI",
            "url": "https://www2.deloitte.com"
          },
          "hasOccupation": {
            "@type": "Occupation",
            "name": "Management Consultant",
            "occupationLocation": {
              "@type": "Country",
              "name": "India"
            },
            "skills": "AI Strategy, Digital Transformation, Operations Excellence, Agile/SAFe, Executive Engagement, Process Automation, Enterprise Architecture, Python, SQL, PL/SQL, Oracle Integration Cloud, Oracle Database, Oracle OIC, KPI Dashboarding"
          },
          "knowsAbout": [
            "AI Strategy and Automation",
            "Digital Transformation",
            "Operations Excellence",
            "Hypothesis-Driven Problem Solving",
            "Enterprise Architecture",
            "Agile SAFe Methodology",
            "Executive Stakeholder Engagement",
            "Process Improvement",
            "Data-Driven Decision Making",
            "Python Programming",
            "SQL Analytics",
            "PL/SQL and Database Architecture",
            "Oracle Enterprise Systems",
            "Oracle Integration Cloud (OIC)",
            "Oracle Database Administration",
            "Enterprise Integration Patterns",
            "Fortune 500 Consulting"
          ],
          "sameAs": [
            "https://www.linkedin.com/in/prnvp/",
            "https://github.com/pranavpahuja"
          ],
          "nationality": {
            "@type": "Country",
            "name": "India"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://pranavpahuja.com/#website",
          "url": "https://pranavpahuja.com",
          "name": "Pranav Pahuja",
          "description": "Official website of Pranav Pahuja — Strategy & Digital Transformation Consultant",
          "publisher": { "@id": "https://pranavpahuja.com/#person" },
          "inLanguage": "en-IN"
        },
        {
          "@type": "WebPage",
          "@id": "https://pranavpahuja.com/#webpage",
          "url": "https://pranavpahuja.com",
          "name": "Pranav Pahuja | Strategy & Digital Transformation Consultant",
          "isPartOf": { "@id": "https://pranavpahuja.com/#website" },
          "about": { "@id": "https://pranavpahuja.com/#person" },
          "description": "Strategy & Digital Transformation Consultant with 6+ years at Deloitte, specializing in AI-enabled operations for Fortune 500 clients. Based in Gurugram, India.",
          "breadcrumb": {
            "@type": "BreadcrumbList",
            "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pranavpahuja.com" }]
          },
          "inLanguage": "en-IN",
          "speakable": {
            "@type": "SpeakableSpecification",
            "cssSelector": ["h1", ".hero-desc", ".section-label"]
          }
        },
        {
          "@type": "ProfessionalService",
          "@id": "https://pranavpahuja.com/#service",
          "name": "Pranav Pahuja — Strategy & Digital Transformation Consulting",
          "description": "AI strategy, digital transformation, and operations excellence consulting for enterprise clients. 6+ years at Deloitte. Fortune 500 track record.",
          "url": "https://pranavpahuja.com",
          "provider": { "@id": "https://pranavpahuja.com/#person" },
          "areaServed": [
            { "@type": "Country", "name": "India" },
            { "@type": "Country", "name": "United States" },
            { "@type": "AdministrativeArea", "name": "Global" }
          ],
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Gurugram",
            "addressRegion": "Haryana",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 28.4595,
            "longitude": 77.0266
          },
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Consulting Services",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI & Automation Strategy" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Digital Transformation" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Operations Excellence" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Executive Engagement & Advisory" } }
            ]
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What does Pranav Pahuja specialize in?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pranav Pahuja is a Strategy & Digital Transformation Consultant with 6+ years at Deloitte Consulting USI. He specializes in AI-enabled operations, process excellence, hypothesis-driven problem solving, and executive stakeholder engagement for Fortune 500 clients across retail, consumer, public services, and healthcare sectors."
              }
            },
            {
              "@type": "Question",
              "name": "What results has Pranav Pahuja delivered for clients?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pranav has eliminated errors by 99.9%, saved 300+ hours per month in manual work, reduced enterprise production failures by approximately 80%, and deployed 50+ operational improvements across mission-critical retail workflows for Fortune 500 clients."
              }
            },
            {
              "@type": "Question",
              "name": "Where is Pranav Pahuja based?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pranav Pahuja is based in Gurugram, Haryana, India, and works with clients globally including Fortune 500 companies in the United States, Europe, and Asia-Pacific."
              }
            },
            {
              "@type": "Question",
              "name": "What certifications does Pranav Pahuja hold?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pranav holds the Deloitte AI Certified credential (ranked 3rd out of 134 practitioners by XP earned in a 9-month program), Google Advanced Data Analytics Professional Certificate, and Oracle Certified Professional certification in Enterprise Integrations and Architecture."
              }
            },
            {
              "@type": "Question",
              "name": "How can I work with Pranav Pahuja?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You can connect with Pranav via LinkedIn at linkedin.com/in/prnvp, email at prnvp@protonmail.ch, or book a call directly at cal.com/pranavpahuja. He is open to consulting engagements, full-time roles in strategy and digital transformation, and advisory arrangements."
              }
            },
            {
              "@type": "Question",
              "name": "What industries has Pranav Pahuja worked in?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pranav has consulting experience across retail (Fortune 500 US retailer), consumer, public services, and healthcare sectors. He has delivered enterprise integration testing, ERP transformation, AI automation, and digital transformation programs across these industries."
              }
            }
          ]
        }
      ]
    }
    </script>
  </head>

  <body class="font-grotesk bg-white text-black relative">

    <!-- Skip to main content (accessibility) -->
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <!-- Scroll progress indicator -->
    <div id="scroll-progress" aria-hidden="true"></div>

    <!-- Cursor spotlight -->
    <div class="cursor-spotlight" id="cursor-spotlight" aria-hidden="true"></div>

    <slot />
    <ResumeViewer client:idle />

    <script>
      // ── Cursor spotlight ──────────────────────────────
      const spotlight = document.getElementById('cursor-spotlight');
      if (spotlight && window.matchMedia('(pointer: fine)').matches) {
        window.addEventListener('mousemove', (e: MouseEvent) => {
          spotlight.style.left = e.clientX + 'px';
          spotlight.style.top  = e.clientY + 'px';
        }, { passive: true });
      } else if (spotlight) {
        spotlight.style.display = 'none';
      }
    </script>

    <!-- ── GSAP ScrollTrigger — all scroll-driven animations ── -->
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ── Scroll progress bar ───────────────────────────
      gsap.to('#scroll-progress', {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: document.documentElement,
          start: 'top top',
          end:   'bottom bottom',
          scrub: 0,
        }
      });

      if (!reduced) {
        // ── Hero parallax ───────────────────────────────
        // Headshot drifts up slower than page (depth illusion)
        gsap.to('#hero-headshot-wrap', {
          y:    -75,
          ease: 'none',
          scrollTrigger: {
            trigger: '#hero-section',
            start:   'top top',
            end:     'bottom top',
            scrub:   1.2,
          }
        });

        // Text drifts down slightly — opposite pull to headshot
        gsap.to('#hero-text-wrap', {
          y:    48,
          ease: 'none',
          scrollTrigger: {
            trigger: '#hero-section',
            start:   'top top',
            end:     'bottom top',
            scrub:   1.6,
          }
        });

        // Blob canvas fades as hero scrolls out
        gsap.to('#hero-blob-canvas', {
          opacity: 0,
          ease:    'power1.in',
          scrollTrigger: {
            trigger: '#hero-section',
            start:   '38% top',
            end:     'bottom top',
            scrub:   1.0,
          }
        });

        // ── Section reveals — replace IntersectionObserver ──
        // Each .fade-in-section enters with 3D rotateX for depth
        gsap.utils.toArray<HTMLElement>('.fade-in-section').forEach((el) => {
          gsap.fromTo(
            el,
            {
              opacity:             0,
              y:                   52,
              rotationX:           4,
              transformPerspective: 1100,
              transformOrigin:     'center top',
            },
            {
              opacity:   1,
              y:         0,
              rotationX: 0,
              duration:  1.05,
              ease:      'power3.out',
              scrollTrigger: {
                trigger:      el,
                start:        'top 88%',
                toggleActions: 'play none none none',
              }
            }
          );
        });

        // ── Service cards — staggered entry ──────────────
        gsap.fromTo(
          '.services-card',
          { opacity: 0, y: 38, scale: 0.97 },
          {
            opacity: 1, y: 0, scale: 1,
            duration: 0.72, stagger: 0.10, ease: 'power3.out',
            scrollTrigger: {
              trigger:       '.services-grid',
              start:         'top 84%',
              toggleActions: 'play none none none',
            }
          }
        );

        // ── Timeline cards — staggered entry ─────────────
        gsap.fromTo(
          '.timeline-card',
          { opacity: 0, y: 34, scale: 0.97 },
          {
            opacity: 1, y: 0, scale: 1,
            duration: 0.75, stagger: 0.13, ease: 'power3.out',
            scrollTrigger: {
              trigger:       '.timeline-grid',
              start:         'top 84%',
              toggleActions: 'play none none none',
            }
          }
        );

        // ── Engagement items — stagger from right ─────────
        gsap.fromTo(
          '.engagement-item',
          { opacity: 0, x: 28 },
          {
            opacity: 1, x: 0,
            duration: 0.60, stagger: 0.08, ease: 'power2.out',
            scrollTrigger: {
              trigger:       '.engagement-list',
              start:         'top 86%',
              toggleActions: 'play none none none',
            }
          }
        );

        // ── FAQ items — stagger ───────────────────────────
        gsap.fromTo(
          '.faq-item',
          { opacity: 0, y: 22 },
          {
            opacity: 1, y: 0,
            duration: 0.55, stagger: 0.08, ease: 'power2.out',
            scrollTrigger: {
              trigger:       '.faq-list',
              start:         'top 88%',
              toggleActions: 'play none none none',
            }
          }
        );

      } else {
        // Reduced motion: make everything visible immediately
        gsap.set('.fade-in-section', { opacity: 1, y: 0 });
      }
    </script>
  </body>
</html>
