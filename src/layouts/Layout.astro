---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Pranav Pahuja | Strategy & Digital Transformation Consultant",
  description = "Strategy & Digital Transformation Consultant with 6+ years at Deloitte, leading AI-enabled operations programs for Fortune 500 clients across retail, consumer, and healthcare sectors."
} = Astro.props;

import ResumeViewer from "../components/ResumeViewer";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pranav Pahuja" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pranavpahuja.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://pranavpahuja.com/images/banner.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://pranavpahuja.com/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://pranavpahuja.com/images/banner.png" />

    <link rel="canonical" href={Astro.url} />

    <!-- Schema.org -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "mainEntity": {
          "@type": "Person",
          "name": "Pranav Pahuja",
          "jobTitle": "Strategy & Digital Transformation Consultant",
          "url": "https://pranavpahuja.com",
          "image": "https://pranavpahuja.com/images/pranav-pahuja.jpg",
          "sameAs": [
            "https://www.linkedin.com/in/prnvp/",
            "https://github.com/pranavpahuja"
          ],
          "description": "Strategy & Digital Transformation Consultant with 6+ years at Deloitte, specializing in AI-enabled operations, digital transformation, and executive stakeholder engagement."
        }
      }
    </script>
  </head>

  <body class="font-grotesk bg-white text-black relative">

    <!-- Cursor spotlight -->
    <div class="cursor-spotlight" id="cursor-spotlight" aria-hidden="true"></div>

    <slot />
    <ResumeViewer client:load />

    <script>
      // ── Cursor spotlight ──────────────────────────────────
      const spotlight = document.getElementById('cursor-spotlight');
      if (spotlight) {
        window.addEventListener('mousemove', (e) => {
          spotlight.style.left = e.clientX + 'px';
          spotlight.style.top  = e.clientY + 'px';
        }, { passive: true });
      }

      // ── Scroll reveal ─────────────────────────────────────
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px', threshold: 0.08 });

      document.querySelectorAll('.fade-in-section').forEach(el => observer.observe(el));

      // ── Staggered children ────────────────────────────────
      const childObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const children = entry.target.querySelectorAll('.stagger-child');
            children.forEach((child, i) => {
              (child as HTMLElement).style.transitionDelay = `${i * 0.08}s`;
              child.classList.add('is-visible');
            });
            childObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.stagger-parent').forEach(el => childObserver.observe(el));
    </script>
  </body>
</html>
