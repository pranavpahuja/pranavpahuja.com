---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Pranav Pahuja | Strategy & Digital Transformation Consultant | Gurugram, India",
  description = "Strategy & Digital Transformation Consultant with 6+ years at Deloitte Consulting. Leads AI-enabled operations programs for Fortune 500 clients across retail, consumer, and healthcare. Based in Gurugram, India. 99.9% error elimination · 180+ hours/month saved · 80% fewer production failures."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://pranavpahuja.com").href;
const ogImage = "https://pranavpahuja.com/images/pranav-pahuja.jpg";
import ResumeViewer from "../components/ResumeViewer";
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- ── Security meta ─────────────────────────────── -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()" />

    <!-- ── Core SEO ──────────────────────────────────── -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pranav Pahuja" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="keywords" content="Strategy Consultant India, Digital Transformation Consultant Gurugram, AI Consultant Deloitte, Management Consultant India, Operations Excellence Consultant, AI Strategy Consultant, Deloitte Consultant India, Pranav Pahuja, Tech Consulting India, Enterprise AI Consultant" />
    <link rel="canonical" href={canonicalURL} />

    <!-- ── GEO / Local SEO ───────────────────────────── -->
    <meta name="geo.region" content="IN-HR" />
    <meta name="geo.placename" content="Gurugram, Haryana, India" />
    <meta name="geo.position" content="28.4595;77.0266" />
    <meta name="ICBM" content="28.4595, 77.0266" />

    <!-- ── Open Graph ────────────────────────────────── -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Pranav Pahuja — Strategy & Digital Transformation Consultant" />
    <meta property="og:site_name" content="Pranav Pahuja" />
    <meta property="og:locale" content="en_IN" />
    <meta property="profile:first_name" content="Pranav" />
    <meta property="profile:last_name" content="Pahuja" />

    <!-- ── Twitter / X Card ──────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Pranav Pahuja — Strategy & Digital Transformation Consultant" />

    <!-- ── Favicon & PWA ─────────────────────────────── -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/pranav-pahuja.jpg" />
    <meta name="theme-color" content="#10b981" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Pranav Pahuja" />

    <!-- ── Performance hints ─────────────────────────── -->
    <link rel="preconnect" href="https://cal.com" />
    <link rel="dns-prefetch" href="https://cal.com" />
    <link rel="preload" href="/fonts/grotesk/SpaceGrotesk-Medium.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/images/pranav-pahuja.jpg" as="image" fetchpriority="high" />

    <!-- ── Rich Structured Data (SEO + GEO + AEO) ───── -->
