<section class="section-dark py-20">
  <div class="container mx-auto px-5">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center relative z-10">

      <!-- Left: Content Card -->
      <div class="col-span-1 md:col-span-7 rounded-[40px] p-10 md:p-14 relative overflow-hidden"
           style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09);">

        <span class="section-label">03 — Credentials</span>
        <h3 class="text-3xl md:text-5xl font-bold text-white mb-12 flex items-center gap-3">
          Certifications <span class="w-3 h-3 rounded-full animate-pulse flex-shrink-0" style="background:#10b981"></span>
        </h3>

        <div class="space-y-8 max-w-xl relative z-10">
          <!-- Item 1 -->
          <div class="group flex gap-6 hover:translate-x-2 transition-transform duration-300">
            <div class="w-[3px] rounded-full flex-shrink-0 transition-colors duration-300"
                 style="background:rgba(255,255,255,0.15); min-height: 60px;"
                 onmouseenter="this.style.background='#10b981'" onmouseleave="this.style.background='rgba(255,255,255,0.15)'"></div>
            <div>
              <span class="text-xs font-bold tracking-widest uppercase mb-1 block" style="color:#34d399">Deloitte AI Certified</span>
              <h4 class="text-xl font-bold text-white mb-1">Deloitte AI Academy</h4>
              <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; line-height:1.6">9-month program of learning, testing & capstone delivery — ranked <strong class="text-white">3rd out of 134 practitioners</strong> by XP earned</p>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="group flex gap-6 hover:translate-x-2 transition-transform duration-300">
            <div class="w-[3px] rounded-full flex-shrink-0 transition-colors duration-300"
                 style="background:rgba(255,255,255,0.15); min-height: 60px;"
                 onmouseenter="this.style.background='#10b981'" onmouseleave="this.style.background='rgba(255,255,255,0.15)'"></div>
            <div>
              <span class="text-xs font-bold tracking-widest uppercase mb-1 block" style="color:#34d399">Certified</span>
              <h4 class="text-xl font-bold text-white mb-1">Google Advanced Data Analytics</h4>
              <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; line-height:1.6">Professional Certificate — Statistical Modeling & Machine Learning</p>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="group flex gap-6 hover:translate-x-2 transition-transform duration-300">
            <div class="w-[3px] rounded-full flex-shrink-0 transition-colors duration-300"
                 style="background:rgba(255,255,255,0.15); min-height: 60px;"
                 onmouseenter="this.style.background='#10b981'" onmouseleave="this.style.background='rgba(255,255,255,0.15)'"></div>
            <div>
              <span class="text-xs font-bold tracking-widest uppercase mb-1 block" style="color:#34d399">Certified</span>
              <h4 class="text-xl font-bold text-white mb-1">Oracle Certified Professional</h4>
              <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; line-height:1.6">Enterprise Integrations, Architecture & Systems</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Wireframe icosahedron -->
      <div id="certs-wire-wrap" class="col-span-1 md:col-span-5 flex justify-center items-center h-[400px] relative">
        <canvas id="certs-wire-canvas" class="absolute inset-0 w-full h-full"></canvas>
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  const wrap   = document.getElementById('certs-wire-wrap');
  const canvas = document.getElementById('certs-wire-canvas') as HTMLCanvasElement | null;
  if (!canvas || !wrap) return;

  const ctx = canvas.getContext('2d')!;
  let W = 0, H = 0;

  function resize() {
    W = wrap.offsetWidth;
    H = wrap.offsetHeight;
    canvas.width  = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    ctx.scale(devicePixelRatio, devicePixelRatio);
  }
  resize();
  window.addEventListener('resize', resize, { passive: true });

  // ── Icosahedron geometry ───────────────────────────────────
  const phi = (1 + Math.sqrt(5)) / 2;
  const raw: [number,number,number][] = [
    [0,1,phi],[0,-1,phi],[0,1,-phi],[0,-1,-phi],
    [1,phi,0],[-1,phi,0],[1,-phi,0],[-1,-phi,0],
    [phi,0,1],[-phi,0,1],[phi,0,-1],[-phi,0,-1],
  ];
  // Normalise to unit sphere
  const verts = raw.map(([x,y,z]) => {
    const len = Math.sqrt(x*x + y*y + z*z);
    return [x/len, y/len, z/len] as [number,number,number];
  });
  const edges: [number,number][] = [
    [0,1],[0,4],[0,5],[0,8],[0,9],
    [1,6],[1,7],[1,8],[1,9],
    [2,3],[2,4],[2,5],[2,10],[2,11],
    [3,6],[3,7],[3,10],[3,11],
    [4,5],[4,8],[4,10],
    [5,9],[5,11],
    [6,7],[6,8],[6,10],
    [7,9],[7,11],
    [8,10],[9,11],
  ];

  // ── Rotation helpers ──────────────────────────────────────
  function rotY([x,y,z]: [number,number,number], a: number): [number,number,number] {
    return [x*Math.cos(a) + z*Math.sin(a), y, -x*Math.sin(a) + z*Math.cos(a)];
  }
  function rotX([x,y,z]: [number,number,number], a: number): [number,number,number] {
    return [x, y*Math.cos(a) - z*Math.sin(a), y*Math.sin(a) + z*Math.cos(a)];
  }

  // ── Mouse tilt ────────────────────────────────────────────
  let tiltX = 0, tiltY = 0, targetTX = 0, targetTY = 0;
  wrap.addEventListener('mousemove', (e: MouseEvent) => {
    const r = canvas.getBoundingClientRect();
    targetTX = ((e.clientY - r.top)  / H - 0.5) *  0.55;
    targetTY = ((e.clientX - r.left) / W - 0.5) * -0.55;
  }, { passive: true });
  wrap.addEventListener('mouseleave', () => { targetTX = 0; targetTY = 0; });

  let t = 0;

  function tick() {
    requestAnimationFrame(tick);
    ctx.clearRect(0, 0, W, H);

    t     += 0.007;
    tiltX += (targetTX - tiltX) * 0.06;
    tiltY += (targetTY - tiltY) * 0.06;

    const scale = Math.min(W, H) * 0.36;
    const cx = W / 2, cy = H / 2;

    // Project all verts
    const proj = verts.map(v => {
      const [x, y, z] = rotX(rotY(v, t + tiltY), tiltX);
      return { sx: cx + x * scale, sy: cy - y * scale, z };
    });

    // Sort edges back-to-front for painter's algorithm
    const sorted = [...edges].sort((a, b) => {
      const az = (proj[a[0]].z + proj[a[1]].z) / 2;
      const bz = (proj[b[0]].z + proj[b[1]].z) / 2;
      return az - bz;
    });

    // Draw edges
    for (const [i, j] of sorted) {
      const avgZ = (proj[i].z + proj[j].z) / 2;
      const alpha = 0.05 + ((avgZ + 1) / 2) * 0.65;
      const lw    = 0.7 + ((avgZ + 1) / 2) * 0.8;
      ctx.beginPath();
      ctx.moveTo(proj[i].sx, proj[i].sy);
      ctx.lineTo(proj[j].sx, proj[j].sy);
      ctx.strokeStyle = `rgba(52,211,153,${alpha})`;
      ctx.lineWidth   = lw;
      ctx.stroke();
    }

    // Draw vertices
    for (const p of proj) {
      const alpha = 0.15 + ((p.z + 1) / 2) * 0.60;
      const r     = 1.4  + ((p.z + 1) / 2) * 2.0;
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(16,185,129,${alpha})`;
      ctx.fill();
    }
  }

  tick();
})();
</script>
