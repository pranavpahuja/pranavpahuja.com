<section class="section-dark py-24">
  <div class="container mx-auto px-5">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center relative z-10">

      <!-- Left: Content Card -->
      <div class="col-span-1 md:col-span-7 rounded-[32px] p-10 md:p-14 relative overflow-hidden"
           style="background:linear-gradient(145deg,rgba(255,255,255,0.08),rgba(255,255,255,0.02));
                  border:1px solid rgba(255,255,255,0.14);
                  backdrop-filter:blur(24px) saturate(150%);
                  box-shadow:inset 0 1px 0 rgba(255,255,255,0.1),0 16px 48px rgba(0,0,0,0.35)">

        <span class="section-label">03 — Credentials</span>
        <h3 class="text-3xl md:text-5xl font-bold text-white mb-12 flex items-center gap-3">
          Certifications
          <span class="w-2.5 h-2.5 rounded-full flex-shrink-0 animate-pulse" style="background:#10b981;box-shadow:0 0 8px rgba(16,185,129,0.6)"></span>
        </h3>

        <div class="space-y-8 max-w-xl relative z-10">
          <!-- Item 1 -->
          <div class="group flex gap-6 hover:translate-x-2 transition-transform duration-300">
            <div class="w-0.5 rounded-full flex-shrink-0 self-stretch transition-colors duration-300"
                 style="background:rgba(255,255,255,0.15); min-height:60px"
                 onmouseenter="this.style.background='#10b981'" onmouseleave="this.style.background='rgba(255,255,255,0.15)'"></div>
            <div>
              <span class="text-xs font-bold tracking-widest uppercase mb-1 block" style="color:#34d399">Deloitte AI Certified</span>
              <h4 class="text-xl font-bold text-white mb-1">Deloitte AI Academy</h4>
              <p style="color:rgba(255,255,255,0.50); font-size:0.9rem; line-height:1.6">9-month program — ranked <strong class="text-white">3rd out of 134 practitioners</strong> by XP earned</p>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="group flex gap-6 hover:translate-x-2 transition-transform duration-300">
            <div class="w-0.5 rounded-full flex-shrink-0 self-stretch transition-colors duration-300"
                 style="background:rgba(255,255,255,0.15); min-height:60px"
                 onmouseenter="this.style.background='#10b981'" onmouseleave="this.style.background='rgba(255,255,255,0.15)'"></div>
            <div>
              <span class="text-xs font-bold tracking-widest uppercase mb-1 block" style="color:#34d399">Certified Practitioner</span>
              <h4 class="text-xl font-bold text-white mb-1">Anthropic Claude Code in Action</h4>
              <p style="color:rgba(255,255,255,0.50); font-size:0.9rem; line-height:1.6">Applied Claude Code for production AI workflows and automation</p>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="group flex gap-6 hover:translate-x-2 transition-transform duration-300">
            <div class="w-0.5 rounded-full flex-shrink-0 self-stretch transition-colors duration-300"
                 style="background:rgba(255,255,255,0.15); min-height:60px"
                 onmouseenter="this.style.background='#10b981'" onmouseleave="this.style.background='rgba(255,255,255,0.15)'"></div>
            <div>
              <span class="text-xs font-bold tracking-widest uppercase mb-1 block" style="color:#34d399">Certified Foundations Associate</span>
              <h4 class="text-xl font-bold text-white mb-1">Oracle Fusion AI Agent Studio</h4>
              <p style="color:rgba(255,255,255,0.50); font-size:0.9rem; line-height:1.6">AI agent design and deployment on Oracle Fusion</p>
            </div>
          </div>

          <!-- Item 4 -->
          <div class="group flex gap-6 hover:translate-x-2 transition-transform duration-300">
            <div class="w-0.5 rounded-full flex-shrink-0 self-stretch transition-colors duration-300"
                 style="background:rgba(255,255,255,0.15); min-height:60px"
                 onmouseenter="this.style.background='#10b981'" onmouseleave="this.style.background='rgba(255,255,255,0.15)'"></div>
            <div>
              <span class="text-xs font-bold tracking-widest uppercase mb-1 block" style="color:#34d399">Certified</span>
              <h4 class="text-xl font-bold text-white mb-1">Google Advanced Data Analytics</h4>
              <p style="color:rgba(255,255,255,0.50); font-size:0.9rem; line-height:1.6">Professional Certificate — Statistical Modeling & Machine Learning</p>
            </div>
          </div>

          <!-- Item 5 -->
          <div class="group flex gap-6 hover:translate-x-2 transition-transform duration-300">
            <div class="w-0.5 rounded-full flex-shrink-0 self-stretch transition-colors duration-300"
                 style="background:rgba(255,255,255,0.15); min-height:60px"
                 onmouseenter="this.style.background='#10b981'" onmouseleave="this.style.background='rgba(255,255,255,0.15)'"></div>
            <div>
              <span class="text-xs font-bold tracking-widest uppercase mb-1 block" style="color:#34d399">Certified</span>
              <h4 class="text-xl font-bold text-white mb-1">Oracle Certified Professional</h4>
              <p style="color:rgba(255,255,255,0.50); font-size:0.9rem; line-height:1.6">Enterprise Integrations, Architecture & Systems</p>
            </div>
          </div>
        </div>

        <!-- Ambient corner glow -->
        <div class="absolute -bottom-16 -right-16 w-64 h-64 rounded-full pointer-events-none"
             style="background:radial-gradient(circle,rgba(16,185,129,0.12),transparent 70%)"></div>
      </div>

      <!-- Right: Paradox abstract wireframe model -->
      <div id="certs-wire-wrap"
           class="col-span-1 md:col-span-5 relative rounded-[32px] overflow-hidden"
           style="height:460px;
                  background:linear-gradient(145deg,rgba(16,185,129,0.04),rgba(255,255,255,0.01));
                  border:1px solid rgba(255,255,255,0.08)">
        <canvas id="certs-wire-canvas" class="absolute inset-0 w-full h-full"></canvas>
        <!-- Radial vignette -->
        <div class="absolute inset-0 pointer-events-none"
             style="background:radial-gradient(ellipse at center,transparent 35%,rgba(10,10,10,0.60) 100%)"></div>
      </div>

    </div>
  </div>
</section>

<script>
import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

(function initPythonModel() {
  const wrap   = document.getElementById('certs-wire-wrap');
  const canvas = document.getElementById('certs-wire-canvas') as HTMLCanvasElement | null;
  if (!canvas || !wrap) return;

  // ── Renderer ────────────────────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.toneMapping     = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure  = 1.3;
  renderer.outputColorSpace     = THREE.SRGBColorSpace;

  let W = wrap.offsetWidth, H = wrap.offsetHeight;
  renderer.setSize(W, H);

  // ── Scene / Camera ───────────────────────────────────────────────
  const scene  = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(42, W / H, 0.01, 100);
  camera.position.set(0, 0, 4.8);

  // ── Lighting ─────────────────────────────────────────────────────
  // Very dark ambient — let the coloured lights do the work
  scene.add(new THREE.AmbientLight(0x030308, 0.4));

  // Primary: warm emerald key from top-left
  const key = new THREE.DirectionalLight(0x34d399, 2.5);
  key.position.set(-3, 5, 4);
  scene.add(key);

  // Rim: cooler green from opposite
  const rim = new THREE.DirectionalLight(0x10b981, 1.4);
  rim.position.set(4, -3, -3);
  scene.add(rim);

  // Inner glow: point light at center for volumetric feel
  const glow = new THREE.PointLight(0x00ff88, 1.8, 8);
  glow.position.set(0, 0, 1);
  scene.add(glow);

  // ── Mouse tilt ───────────────────────────────────────────────────
  let tiltX = 0, tiltY = 0, targetTX = 0, targetTY = 0;
  wrap.addEventListener('mousemove', (e: MouseEvent) => {
    const r = wrap.getBoundingClientRect();
    targetTX = ((e.clientY - r.top)  / H - 0.5) *  0.85;
    targetTY = ((e.clientX - r.left) / W - 0.5) * -0.85;
  }, { passive: true });
  wrap.addEventListener('mouseleave', () => { targetTX = 0; targetTY = 0; });

  // ── Load GLB ─────────────────────────────────────────────────────
  let model: THREE.Group | null = null;
  let mixer: THREE.AnimationMixer | null = null;

  new GLTFLoader().load('/models/paradox_abstract_art_of_python.glb', (gltf) => {
    model = gltf.scene;

    // Scale to fill panel
    const box    = new THREE.Box3().setFromObject(model);
    const size   = box.getSize(new THREE.Vector3());
    const maxDim = Math.max(size.x, size.y, size.z);
    const scale  = 3.4 / maxDim;
    const center = box.getCenter(new THREE.Vector3());
    model.scale.setScalar(scale);
    model.position.set(-center.x * scale, -center.y * scale, -center.z * scale);

    // Tint all geometry to brand green
    model.traverse((child) => {
      // Mesh surfaces
      if ((child as THREE.Mesh).isMesh) {
        const mesh = child as THREE.Mesh;
        const applyGreen = (mat: THREE.Material) => {
          const m = mat as THREE.MeshStandardMaterial;
          if ('color' in m) m.color.set(0x34d399);
          if ('emissive' in m) m.emissive?.set(0x062218);
          if ('opacity' in m) {
            m.transparent = true;
            m.opacity = Math.min((m.opacity ?? 1), 0.90);
          }
        };
        Array.isArray(mesh.material)
          ? mesh.material.forEach(applyGreen)
          : applyGreen(mesh.material);
      }
      // Lines / wireframe strands
      if ((child as THREE.Line).isLine) {
        (child as THREE.Line).material = new THREE.LineBasicMaterial({
          color: 0x34d399, transparent: true, opacity: 0.75,
        });
      }
    });

    // Play built-in animations if present
    if (gltf.animations?.length) {
      mixer = new THREE.AnimationMixer(model);
      gltf.animations.forEach(clip => mixer!.clipAction(clip).play());
    }

    scene.add(model);
  });

  // ── Animate ──────────────────────────────────────────────────────
  const clock = new THREE.Clock();
  let t = 0;

  function tick() {
    requestAnimationFrame(tick);
    const delta = clock.getDelta();
    t += delta;

    tiltX += (targetTX - tiltX) * 0.06;
    tiltY += (targetTY - tiltY) * 0.06;

    if (model) {
      model.rotation.y = t * 0.28 + tiltY;
      model.rotation.x = tiltX * 0.6;
      model.rotation.z = Math.sin(t * 0.18) * 0.025;
    }

    // Pulse inner glow
    glow.intensity = 1.6 + Math.sin(t * 2.4) * 0.5;

    if (mixer) mixer.update(delta);
    renderer.render(scene, camera);
  }

  tick();

  window.addEventListener('resize', () => {
    W = wrap.offsetWidth;
    H = wrap.offsetHeight;
    camera.aspect = W / H;
    camera.updateProjectionMatrix();
    renderer.setSize(W, H);
  }, { passive: true });

  document.addEventListener('visibilitychange', () => {
    document.hidden ? clock.stop() : clock.start();
  });
})();
</script>
