---
---
<section class="container mx-auto px-5 mb-20 fade-in-section">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Education -->
    <div class="h-full glass-panel p-8 rounded-[30px] hover:bg-white transition-all duration-300 shadow-sm hover:shadow-md">
      <span class="section-label">Background</span>
      <h3 class="text-2xl font-bold mb-6 text-black">Education</h3>
      <div class="py-2">
        <p class="text-gray-500 mb-2 font-medium text-sm">2016 – 2020</p>
        <h5 class="text-xl font-bold mb-1 text-black">Bachelor of Technology</h5>
        <p class="text-gray-600 font-medium mb-1">Computer Engineering</p>
        <p class="text-gray-500 text-sm mb-5">Thapar Institute of Engineering & Technology, Patiala</p>
        <ul class="space-y-2.5 text-sm text-gray-500">
          <li class="flex items-start gap-2">
            <span class="text-green mt-0.5 flex-shrink-0">→</span>
            Finalist, Smart India Hackathon 2018 — Project Haazri (automated attendance system)
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green mt-0.5 flex-shrink-0">→</span>
            Ranked nationally in leadership communication, Toastmasters International
          </li>
        </ul>
      </div>
    </div>

    <!-- Professional Experience -->
    <div class="h-full glass-panel text-black p-8 rounded-[30px] hover:bg-white transition-all duration-300 shadow-sm hover:shadow-md">
      <span class="section-label">02 — Career</span>
      <h3 class="text-2xl font-bold mb-6 text-black">Professional Experience</h3>
      <div class="space-y-6">
        <div>
          <p class="text-gray-500 mb-1 font-medium text-xs tracking-widest uppercase">2023 – Present</p>
          <h5 class="text-lg font-bold mb-0.5 text-black leading-tight">Deloitte Consulting USI</h5>
          <p class="text-gray-700 font-semibold mb-2 text-sm">Consultant – Strategy & Digital Transformation</p>
          <p class="text-gray-500 text-sm leading-relaxed">
            AI and automation strategy across client engagements. Owned end-to-end delivery for a Fortune 500 US retailer — 99.9% error reduction, 180+ hrs/month saved, 80% fewer production failures.
          </p>
        </div>
        <div class="border-t border-gray-100 pt-5">
          <p class="text-gray-500 mb-1 font-medium text-xs tracking-widest uppercase">2020 – 2023</p>
          <h5 class="text-lg font-bold mb-0.5 text-black leading-tight">Deloitte Consulting USI</h5>
          <p class="text-gray-700 font-semibold mb-2 text-sm">Analyst – Business Operations & Technology</p>
          <p class="text-gray-500 text-sm leading-relaxed">
            Designed 50+ automation scripts achieving 90% error reduction and 10x time savings. Automated reporting saving 4+ FTE hours/day.
          </p>
        </div>
        <div class="border-t border-gray-100 pt-5">
          <p class="text-gray-500 mb-1 font-medium text-xs tracking-widest uppercase">2019 – 2020</p>
          <h5 class="text-lg font-bold mb-0.5 text-black leading-tight">Deloitte USI / EXL Services</h5>
          <p class="text-gray-700 font-semibold mb-2 text-sm">Early Professional Experience</p>
          <p class="text-gray-500 text-sm leading-relaxed">
            ERP transformation delivery and security risk analysis across healthcare and enterprise clients.
          </p>
        </div>
      </div>
      <div class="pt-5">
        <button onclick="window.dispatchEvent(new CustomEvent('open-resume-modal'))"
                class="text-green font-medium hover:underline cursor-pointer text-sm flex items-center gap-1">
          View detailed resume →
        </button>
      </div>
    </div>

    <!-- Beyond Work -->
    <div class="h-full glass-panel p-8 rounded-[30px] hover:bg-white transition-all duration-300 shadow-sm hover:shadow-md">
      <span class="section-label">Profile</span>
      <h3 class="text-2xl font-bold mb-6 text-black">Beyond Work</h3>
      <div class="space-y-5">
        <div>
          <h5 class="text-lg font-bold mb-1 text-black">Golf</h5>
          <p class="text-gray-500 text-sm leading-relaxed">Long-horizon discipline and precision decision-making under pressure — same muscle as consulting.</p>
        </div>
        <div class="border-t border-gray-50 pt-4">
          <h5 class="text-lg font-bold mb-1 text-black">Aviation & Flight Simulation</h5>
          <p class="text-gray-500 text-sm leading-relaxed">Real-time judgment in resource-constrained, high-stakes environments.</p>
        </div>
        <div class="border-t border-gray-50 pt-4">
          <h5 class="text-lg font-bold mb-1 text-black">Astronomy & Applied Physics</h5>
          <p class="text-gray-500 text-sm leading-relaxed">Systems-level thinking and first-principles problem decomposition.</p>
        </div>
        <div class="border-t border-gray-50 pt-4">
          <h5 class="text-lg font-bold mb-1 text-black">International Travel</h5>
          <p class="text-gray-500 text-sm leading-relaxed">Exposure to diverse business environments and cross-cultural collaboration.</p>
        </div>
      </div>
    </div>

  </div>
</section>
