---
---
<section class="section-dark py-24">
  <div class="container mx-auto px-5">

    <!-- Section header — full row -->
    <div class="mb-10">
      <span class="section-label">05 — Working Together</span>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">
          How I Engage<span style="color:#34d399">.</span>
        </h2>
        <p style="color:rgba(255,255,255,0.50)" class="text-base md:text-lg max-w-sm leading-relaxed md:text-right">
          How I work — bringing both business understanding and technical depth to every engagement.
        </p>
      </div>
    </div>

    <!-- Two-column: big orbital left, list right -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 relative z-10 items-center">

      <!-- Orbital — generous 7-column canvas -->
      <div id="engagement-orbit-wrap"
           class="col-span-1 md:col-span-7 relative rounded-[28px] overflow-hidden"
           style="height:520px;
                  background:linear-gradient(145deg,rgba(255,255,255,0.03),rgba(10,10,10,0));
                  border:1px solid rgba(255,255,255,0.06)">
        <canvas id="engagement-orbit-canvas" class="absolute inset-0 w-full h-full"></canvas>
        <!-- Vignette -->
        <div class="absolute inset-0 pointer-events-none rounded-[28px]"
             style="background:radial-gradient(ellipse at center,transparent 42%,rgba(10,10,10,0.5) 100%)"></div>
      </div>

      <!-- Engagement list — 5 columns -->
      <div class="engagement-list col-span-1 md:col-span-5 flex flex-col gap-3">
        {[
          'Deep expertise and business understanding',
          'Hypothesis-driven problem framing',
          'Clear outcomes and decision milestones',
          'Flexible models: advisory, build, scale',
          'Cross-functional coordination & PI Planning',
          'Confidential, enterprise-grade delivery',
        ].map(item => (
          <div class="engagement-item group flex items-center justify-between p-5 rounded-2xl cursor-default transition-all duration-300"
               style="background:linear-gradient(135deg,rgba(255,255,255,0.06),rgba(255,255,255,0.02));
                      border:1px solid rgba(255,255,255,0.10);
                      backdrop-filter:blur(16px);
                      box-shadow:inset 0 1px 0 rgba(255,255,255,0.07)"
               onmouseenter="this.style.background='linear-gradient(135deg,rgba(16,185,129,0.12),rgba(16,185,129,0.04))';this.style.borderColor='rgba(16,185,129,0.30)'"
               onmouseleave="this.style.background='linear-gradient(135deg,rgba(255,255,255,0.06),rgba(255,255,255,0.02))';this.style.borderColor='rgba(255,255,255,0.10)'">
            <span class="text-base font-semibold text-white/85">{item}</span>
            <span class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 ml-4 opacity-0 group-hover:opacity-100 transition-opacity"
                  style="background:rgba(16,185,129,0.2);color:#34d399">→</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  const wrap   = document.getElementById('engagement-orbit-wrap');
  const canvas = document.getElementById('engagement-orbit-canvas') as HTMLCanvasElement | null;
  if (!canvas || !wrap) return;

  const ctx = canvas.getContext('2d')!;
  let W = 0, H = 0;

  function resize() {
    W = wrap.offsetWidth;
    H = wrap.offsetHeight;
    canvas.width  = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    ctx.scale(devicePixelRatio, devicePixelRatio);
  }
  resize();
  window.addEventListener('resize', resize, { passive: true });

  // ── Three orbital rings — higher tilt = more spherical/3D look ──
  const rings = [
    { a: 0,     speed:  0.014, dotCount: 2, dotR: 6.0, tilt: 0.62 },
    { a: 1.1,   speed: -0.009, dotCount: 3, dotR: 4.8, tilt: 0.52 },
    { a: 0.55,  speed:  0.005, dotCount: 5, dotR: 3.5, tilt: 0.42 },
  ];

  let hovered  = false;
  let speedMul = 1;

  wrap.addEventListener('mouseenter', () => { hovered = true; });
  wrap.addEventListener('mouseleave', () => { hovered = false; });

  let t = 0;

  function tick() {
    requestAnimationFrame(tick);
    ctx.clearRect(0, 0, W, H);

    const target = hovered ? 2.8 : 1;
    speedMul += (target - speedMul) * 0.05;
    t        += 0.01 * speedMul;

    const cx = W * 0.50;   // centred in its column
    const cy = H * 0.52;

    // Fill the taller canvas — H is now generous enough
    const maxR = Math.min(W * 0.42, H * 0.44);
    const radii = [maxR * 0.36, maxR * 0.64, maxR];

    for (let ri = 0; ri < rings.length; ri++) {
      const ring = rings[ri];
      const rx   = radii[ri];
      const ry   = rx * ring.tilt;

      // Ring ellipse — slightly brighter
      ctx.beginPath();
      ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(16,185,129,0.25)';
      ctx.lineWidth   = 1.2;
      ctx.stroke();

      // Orbiting dots
      for (let d = 0; d < ring.dotCount; d++) {
        const angle = t * ring.speed * 80 + ring.a + (d / ring.dotCount) * Math.PI * 2;
        const x = cx + Math.cos(angle) * rx;
        const y = cy + Math.sin(angle) * ry;

        const depth = Math.sin(angle);
        const alpha = 0.32 + ((depth + 1) / 2) * 0.64;
        const r     = ring.dotR * (0.58 + ((depth + 1) / 2) * 0.62);

        // Outer glow
        const grd = ctx.createRadialGradient(x, y, 0, x, y, r * 4.5);
        grd.addColorStop(0, `rgba(52,211,153,${alpha * 0.55})`);
        grd.addColorStop(1, 'rgba(52,211,153,0)');
        ctx.beginPath();
        ctx.arc(x, y, r * 4.5, 0, Math.PI * 2);
        ctx.fillStyle = grd;
        ctx.fill();

        // Core dot
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(52,211,153,${alpha})`;
        ctx.fill();
      }
    }

    // ── Pulsing centre node ────────────────────────────────
    const pulse = 0.85 + Math.sin(t * 2.5) * 0.13;

    const cgrd = ctx.createRadialGradient(cx, cy, 0, cx, cy, 14 * pulse);
    cgrd.addColorStop(0, 'rgba(52,211,153,0.85)');
    cgrd.addColorStop(0.4, 'rgba(52,211,153,0.30)');
    cgrd.addColorStop(1, 'rgba(52,211,153,0)');
    ctx.beginPath();
    ctx.arc(cx, cy, 14 * pulse, 0, Math.PI * 2);
    ctx.fillStyle = cgrd;
    ctx.fill();

    ctx.beginPath();
    ctx.arc(cx, cy, 4.5 * pulse, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(52,211,153,0.95)';
    ctx.fill();
  }

  tick();
})();
</script>
