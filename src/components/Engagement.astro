---
---
<section class="section-dark">
  <div class="container mx-auto px-5 py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 relative z-10">

      <div class="flex flex-col justify-between">
        <div>
          <span class="section-label">05 — Working Together</span>
          <h2 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
            How I<br/>Engage<span style="color:#34d399">.</span>
          </h2>
          <p style="color:rgba(255,255,255,0.55)" class="text-lg max-w-sm">
            Flexible models designed to fit your enterprise needs — from advisory to full-scale delivery.
          </p>
        </div>

        <!-- Orbital animation -->
        <div id="engagement-orbit-wrap" class="relative w-full h-[260px] mt-10">
          <canvas id="engagement-orbit-canvas" class="absolute inset-0 w-full h-full"></canvas>
        </div>
      </div>

      <div class="engagement-list grid grid-cols-1 gap-3">
        {[
          'Senior-led, hands-on engagements',
          'Hypothesis-driven problem framing',
          'Clear outcomes and decision milestones',
          'Flexible models: advisory, build, scale',
          'Cross-functional coordination & PI Planning',
          'Confidential, enterprise-grade delivery',
        ].map(item => (
          <div class="engagement-item group flex items-center justify-between p-5 rounded-2xl transition-all duration-300 cursor-default"
               style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07);"
               onmouseenter="this.style.background='rgba(16,185,129,0.08)'; this.style.borderColor='rgba(16,185,129,0.25)'"
               onmouseleave="this.style.background='rgba(255,255,255,0.04)'; this.style.borderColor='rgba(255,255,255,0.07)'">
            <span class="text-base font-semibold text-white/85">{item}</span>
            <span class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 ml-4 opacity-0 group-hover:opacity-100 transition-opacity"
                  style="background:rgba(16,185,129,0.2); color:#34d399">→</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  const wrap   = document.getElementById('engagement-orbit-wrap');
  const canvas = document.getElementById('engagement-orbit-canvas') as HTMLCanvasElement | null;
  if (!canvas || !wrap) return;

  const ctx = canvas.getContext('2d')!;
  let W = 0, H = 0;

  function resize() {
    W = wrap.offsetWidth;
    H = wrap.offsetHeight;
    canvas.width  = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    ctx.scale(devicePixelRatio, devicePixelRatio);
  }
  resize();
  window.addEventListener('resize', resize, { passive: true });

  // ── Orbital rings definition ───────────────────────────────
  // tilt = y-scale of ellipse (gives 3D perspective feel)
  const rings = [
    { a: 0,     speed:  0.014, dotCount: 2, dotR: 3.5, tilt: 0.38 },
    { a: 1.1,   speed: -0.008, dotCount: 3, dotR: 2.8, tilt: 0.24 },
    { a: 0.55,  speed:  0.005, dotCount: 5, dotR: 2.2, tilt: 0.16 },
  ];

  let hovered  = false;
  let speedMul = 1;

  wrap.addEventListener('mouseenter', () => { hovered = true; });
  wrap.addEventListener('mouseleave', () => { hovered = false; });

  let t = 0;

  function tick() {
    requestAnimationFrame(tick);
    ctx.clearRect(0, 0, W, H);

    // Smoothly ramp speed on hover
    const target  = hovered ? 2.8 : 1;
    speedMul += (target - speedMul) * 0.05;
    t        += 0.01 * speedMul;

    const cx = W * 0.38;   // slightly left of center so list text has room
    const cy = H * 0.55;
    const maxR = Math.min(W * 0.32, H * 0.42);

    // Radii spaced out
    const radii = [maxR * 0.38, maxR * 0.65, maxR];

    for (let ri = 0; ri < rings.length; ri++) {
      const ring = rings[ri];
      const rx   = radii[ri];
      const ry   = rx * ring.tilt;

      // Ring ellipse
      ctx.beginPath();
      ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(16,185,129,0.15)';
      ctx.lineWidth   = 0.9;
      ctx.stroke();

      // Orbiting dots
      for (let d = 0; d < ring.dotCount; d++) {
        const angle = t * ring.speed * 80 + ring.a + (d / ring.dotCount) * Math.PI * 2;
        const x = cx + Math.cos(angle) * rx;
        const y = cy + Math.sin(angle) * ry;
        // depth: sin of angle mapped to opacity + size
        const depth = Math.sin(angle);
        const alpha = 0.28 + ((depth + 1) / 2) * 0.62;
        const r     = ring.dotR * (0.65 + ((depth + 1) / 2) * 0.55);

        // Soft glow around dot
        const grd = ctx.createRadialGradient(x, y, 0, x, y, r * 3.5);
        grd.addColorStop(0, `rgba(52,211,153,${alpha * 0.45})`);
        grd.addColorStop(1, 'rgba(52,211,153,0)');
        ctx.beginPath();
        ctx.arc(x, y, r * 3.5, 0, Math.PI * 2);
        ctx.fillStyle = grd;
        ctx.fill();

        // Solid dot
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(52,211,153,${alpha})`;
        ctx.fill();
      }
    }

    // Centre node
    const cgrd = ctx.createRadialGradient(cx, cy, 0, cx, cy, 6);
    cgrd.addColorStop(0, 'rgba(52,211,153,0.7)');
    cgrd.addColorStop(1, 'rgba(52,211,153,0)');
    ctx.beginPath();
    ctx.arc(cx, cy, 6, 0, Math.PI * 2);
    ctx.fillStyle = cgrd;
    ctx.fill();
    ctx.beginPath();
    ctx.arc(cx, cy, 2.5, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(52,211,153,0.85)';
    ctx.fill();
  }

  tick();
})();
</script>
