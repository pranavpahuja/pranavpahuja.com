---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Stats from '../components/Stats.tsx';
import Services from '../components/Services.astro';
import Timeline from '../components/Timeline.astro';
import Certifications from '../components/Certifications.astro';
import Testimonials from '../components/Testimonials.tsx';
import Engagement from '../components/Engagement.astro';
import RocketCTA from '../components/RocketCTA.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Pranav Pahuja | Strategy & Digital Transformation Consultant | Gurugram, India"
  description="Strategy & Digital Transformation Consultant with 6+ years at Deloitte. Leads AI-enabled operations programs for Fortune 500 clients. 99.9% error elimination · 300+ hours/month saved · 80% fewer production failures. Based in Gurugram, India."
>
  <Header />
  <main id="main-content">

    <!-- Light: Hero with aurora + headshot -->
    <Hero />

    <!-- Dark: Marquee ticker -->
    <Marquee />

    <!-- Light: Stats bar -->
    <Stats client:visible />

    <!-- Dark: Core Competencies -->
    <Services />

    <!-- Light: Experience + Education + Profile -->
    <Timeline />

    <!-- Dark: Certifications -->
    <Certifications />

    <!-- Light: Testimonials -->
    <Testimonials client:visible />

    <!-- Dark: How I Engage -->
    <Engagement />

    <!-- Dark: Rocket CTA — Let's Launch -->
    <RocketCTA />

    <!-- Light: FAQ (AEO) -->
    <FAQ />

    <!-- Light: Contact -->
    <Contact />

  </main>
  <Footer />
</Layout>
